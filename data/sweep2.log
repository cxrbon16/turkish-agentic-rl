import csv
import json
import os

result = []
for filename in sorted(os.listdir('kargo')):
    if filename.endswith('.csv'):
        with open(os.path.join('kargo', filename), 'r') as f:
            reader = csv.reader(f)
            for row in reader:
                if row:
                    first_col = row[0][::-1]
                    second_col = row[1]
                    result.append([first_col, second_col])
with open('kargo.json', 'w') as f:
    json.dump(result, f)
EOF
