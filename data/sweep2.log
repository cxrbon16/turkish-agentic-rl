with open("patients.csv", "r") as f:
    patients = list(csv.DictReader(f))

with open("appointments.csv", "r") as f:
    appointments = list(csv.DictReader(f))

for patient in patients:
    patient_name = patient["Name"]
    patient_id = patient["ID"]
    
    # Klasör oluştur
    os.makedirs(patient_name, exist_ok=True)
    
    # Hastaya ait randevuları bul ve dosyaya yaz
    patient_appointments = [app for app in appointments if app["PatientID"] == patient_id]
    if patient_appointments:
        file_path = os.path.join(patient_name, f"appointments_{patient_id}.txt")
        with open(file_path, "w") as f:
            for app in patient_appointments:
                f.write(f"AppID: {app["AppID"]}, Date: {app["Date"]}, Doctor: {app["Doctor"]}\n")

# Klasörleri arşivle
os.system("tar -cvf appointments_archive.tar " + " ".join(patient["Name"] for patient in patients if os.path.isdir(patient["Name"])))
'

