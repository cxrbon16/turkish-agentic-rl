--- tur 3 ---
  $ cat << 'EOF' > solution.py
import csv
import json
import os

kargo_dir = 'kargo'
output_file = 'kargo.json'
data = []

csv_files = [f for f in os.listdir(kargo_dir) if f.endswith('.csv')]
csv_files.sort()

for filename in csv_files:
    filepath = os.path.join(kargo_dir, filename)
    with open(filepath, mode='r', encoding='utf-8') as csvfile:
        reader = csv.reader(csvfile)
        for row in reader:
            if not row:
                continue
            reversed_col1 = row[0][::-1]
            col2 = row[1]
            data.append({
                'column1': reversed_col1,
                'column2': col2
            })

with open(output_file, mode='w', encoding='utf-8') as jsonfile:
    json.dump(data, jsonfile, indent=4)
EOF
